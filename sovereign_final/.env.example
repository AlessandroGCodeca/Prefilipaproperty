# Sovereign RE Dashboard — Environment Variables
# Copy this file to .env and fill in your values. Docker reads it each time the
# containers start (`docker compose up -d`); no rebuild needed after an edit.

# Dashboard password. Blank = no login, which is only safe while the dashboard
# is reachable from this computer alone (docker-compose.yml binds it to
# 127.0.0.1). Set one before opening it to your network or the internet.
DASHBOARD_PASSWORD=

# Storage is SQLite (data/sovereign.db) — no database settings needed. Older
# copies of this file set DATABASE_URL to a Postgres server; it is now ignored.

# Google Places API (for Location IQ + Satellite Viewer)
# Get at: console.cloud.google.com → Enable Places API + Geocoding API
# Free $200/month credit — sufficient for personal use
GOOGLE_PLACES_API_KEY=

# Slovak cadastre (LV debt checking) needs NO key: ÚGKK SR has no public API,
# so kataster_scraper.py scrapes kataster.skgeodesy.sk directly.

# ScraperAPI — REQUIRED if running on a cloud/server IP that is blocked by real estate sites
# Free tier: 5,000 requests/month — enough for daily scraping
# Sign up free at: https://www.scraperapi.com
# Without this key the scrapers make direct requests (works on home/residential internet)
SCRAPER_API_KEY=

# Anthropic Claude API (optional — cloud LLM for listing enrichment)
# Used to parse Slovak free-text descriptions, fix blank districts, and run
# structured LV title-deed analysis. Get a key at: https://console.anthropic.com
# Leave blank to disable (enrichment helpers no-op gracefully without it).
#
# SECURITY: put the real key in your local .env ONLY. .env is gitignored, so the
# secret never enters the repo. Never paste a live key into this .env.example,
# into source files, or into chat — rotate immediately if a key is exposed.
ANTHROPIC_API_KEY=
# Model id — defaults to claude-sonnet-4-6 if unset. Override for a different tier.
ANTHROPIC_MODEL=claude-sonnet-4-6

# How many residential properties you already own. At 2+, your next purchase
# is a 3rd+ property and NBS caps the loan at 70% LTV (from 1 Oct 2026), so
# scoring uses 70% instead of 80%.
PROPERTIES_OWNED=0

# OpenStreetMap (no key needed). Location IQ uses Nominatim to geocode when no
# Google key is set; its usage policy asks for a contact email.
NOMINATIM_EMAIL=
# Optional overrides for the open-data endpoints (modules/risk_data.py).
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# FLOOD_IDENTIFY_URL=https://mpt.svp.sk/server/rest/services/MPOMPR_II/Op_Ohrozenie_Q/MapServer/identify
# FLOOD_LAYER_IDS=24

# Daily backups (backups/ in this folder): how many of each kind to keep.
# BACKUP_KEEP=14
